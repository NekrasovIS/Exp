      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "ci-metrics-postgres" },
          "format": "table",
          "rawSql": "SELECT j.job_name, j.kind, j.service, j.sanitizer, j.conclusion, j.tests_total, j.tests_failed, j.duration_seconds FROM ci_job_results j WHERE j.run_id = (SELECT run_id FROM ci_runs WHERE branch IN ($branch) ORDER BY created_at DESC LIMIT 1) ORDER BY j.kind, j.service NULLS FIRST, j.sanitizer",
