  +deleteCommunity(id: int64, requesterLogin: string) : MutationResult
  +createChannel(communityId: int64, name: string, ownerLogin: string,\n    isEncrypted: bool = false) : optional<int64>
  +listChannels(communityId: int64) : vector<Channel>
  +findChannel(id: int64) : optional<Channel>
  +listMembers(communityId: int64) : vector<string>
  +renameChannel(id: int64, newName: string, requesterLogin: string) : MutationResult
  +deleteChannel(id: int64, requesterLogin: string) : MutationResult
  +joinCommunity(communityId: int64, login: string) : bool
  +promoteModerator(communityId: int64, targetLogin: string, requesterLogin: string) : MutationResult
  +demoteModerator(communityId: int64, targetLogin: string, requesterLogin: string) : MutationResult
  +listModerators(communityId: int64) : vector<string>
  +insertMessage(channelId: int64, authorLogin: string, body: string,\n    attachmentId: optional<int64> = nullopt) : optional<Message>
  +createAttachment(channelId: int64, uploaderLogin: string, filename: string,\n    contentType: string, dataBase64: string, sizeBytes: int64) : optional<AttachmentMetadata>
  +findAttachmentData(attachmentId: int64) : optional<AttachmentData>
  +listRecentMessages(channelId: int64, limit: int, beforeId: optional<int64>) : vector<Message>
  +editMessage(messageId: int64, channelId: int64, requesterLogin: string, newBody: string) : EditMessageResult
  +deleteMessage(messageId: int64, channelId: int64, requesterLogin: string) : MutationResult
  +searchMessages(channelId: int64, query: string, limit: int) : vector<Message>
  +setChannelKey(channelId: int64, memberLogin: string, requesterLogin: string,\n    wrappedKey: string) : MutationResult
  +findChannelKey(channelId: int64, login: string) : optional<string>
}
ChatRepository ..> Community : creates
ChatRepository ..> Channel : creates
ChatRepository ..> Message : creates
ChatRepository ..> AttachmentMetadata : creates
ChatRepository ..> AttachmentData : reads
ChatRepository ..> MutationResult : returns
ChatRepository ..> PqxxConnection : opens per call

