@startuml chat-service
title chat-service — src/

package "cpp-httplib / ixwebsocket" {
  class "httplib::Server" as HttplibServer
  class "ix::WebSocketServer" as IxWebSocketServer
}

package "libpqxx" {
  class "pqxx::connection" as PqxxConnection
}

class Community {
  +id : int64
  +name : string
  +ownerLogin : string
}
class Channel {
  +id : int64
  +communityId : int64
  +name : string
  +ownerLogin : string
}
class Message {
  +id : int64
  +authorLogin : string
  +body : string
  +sentAt : string
}
enum MutationResult {
  kSuccess
  kNotFound
  kForbidden
  kConflict
}

class ChatRepository {
  +createCommunity(name: string, ownerLogin: string) : Community
  +listCommunities() : vector<Community>
  +renameCommunity(id: int64, newName: string, requesterLogin: string) : MutationResult
  +deleteCommunity(id: int64, requesterLogin: string) : MutationResult
  +createChannel(communityId: int64, name: string, ownerLogin: string) : optional<int64>
  +listChannels(communityId: int64) : vector<Channel>
  +renameChannel(id: int64, newName: string, requesterLogin: string) : MutationResult
  +deleteChannel(id: int64, requesterLogin: string) : MutationResult
  +joinCommunity(communityId: int64, login: string) : bool
  +insertMessage(channelId: int64, authorLogin: string, body: string) : optional<Message>
  +listRecentMessages(channelId: int64, limit: int, beforeId: optional<int64>) : vector<Message>
  +editMessage(messageId: int64, channelId: int64, requesterLogin: string, newBody: string) : EditMessageResult
  +deleteMessage(messageId: int64, channelId: int64, requesterLogin: string) : MutationResult
  +searchMessages(channelId: int64, query: string, limit: int) : vector<Message>
}
ChatRepository ..> Community : creates
ChatRepository ..> Channel : creates
ChatRepository ..> Message : creates
ChatRepository ..> MutationResult : returns
ChatRepository ..> PqxxConnection : opens per call

class ChatService {
  +createCommunity(name: string, ownerLogin: string) : Community
  +listCommunities() : vector<Community>
  +renameCommunity(id: int64, newName: string, requesterLogin: string) : MutationResult
  +deleteCommunity(id: int64, requesterLogin: string) : MutationResult
  +createChannel(communityId: int64, name: string, ownerLogin: string) : optional<int64>
  +listChannels(communityId: int64) : vector<Channel>
  +renameChannel(id: int64, newName: string, requesterLogin: string) : MutationResult
  +deleteChannel(id: int64, requesterLogin: string) : MutationResult
  +joinCommunity(communityId: int64, login: string) : bool
  +postMessage(channelId: int64, authorLogin: string, body: string) : optional<Message>
  +recentMessages(channelId: int64, limit: int, beforeId: optional<int64>) : vector<Message>
  +editMessage(messageId: int64, channelId: int64, requesterLogin: string, newBody: string) : EditMessageResult
  +deleteMessage(messageId: int64, channelId: int64, requesterLogin: string) : MutationResult
  +searchMessages(channelId: int64, query: string, limit: int) : vector<Message>
}
ChatService --> ChatRepository : delegates to (&)

class AuthServiceClient {
  +verifyToken(token: string) : optional<string>
}
AuthServiceClient ..> "auth-service" : POST /auth/verify

class HttpServer {
  +listen(host: string, port: int)
  +stop()
  -authenticate(request) : optional<string>
  -handleCreateCommunity(request, response)
  -handleListCommunities(request, response)
  -handleRenameCommunity(request, response)
  -handleDeleteCommunity(request, response)
  -handleJoinCommunity(request, response)
  -handleCreateChannel(request, response)
  -handleListChannels(request, response)
  -handleRenameChannel(request, response)
  -handleDeleteChannel(request, response)
  -handleListMessages(request, response)
  -handleSearchMessages(request, response)
  -writeMutationResult(result: MutationResult, response)
}
HttpServer --> ChatService : delegates to (&)
HttpServer --> AuthServiceClient : authenticates via (const&)
HttpServer *-- HttplibServer : owns

class WebSocketServer {
  +start() : bool
  +stop()
  -handleMessage(connectionState, webSocket, message)
  -handleHello(webSocket, payload)
  -handleSubscribedMessage(webSocket, payload)
  -handleChatMessage(webSocket, subscription, body)
  -handleEditMessage(webSocket, subscription, body)
  -handleDeleteMessage(webSocket, subscription, body)
  -handleCallJoin(webSocket, subscription)
  -handleCallLeave(webSocket, subscription)
  -handleCallSignal(webSocket, subscription, body)
  -handleTyping(webSocket, subscription)
  -removeCallParticipant(subscription, socket)
  -broadcastToChannel(channelId: int64, json: string, excludeSocket)
  -broadcastToCallParticipants(channelId: int64, json: string, excludeSocket)
}
WebSocketServer --> ChatService : delegates to (&)
WebSocketServer --> AuthServiceClient : authenticates via (const&)
WebSocketServer *-- IxWebSocketServer : owns

note right of HttpServer
  Routes (all require
  Authorization: Bearer <token>):
  POST   /communities
  GET    /communities
  PATCH  /communities/{id}   (owner only)
  DELETE /communities/{id}   (owner only)
  POST   /communities/{id}/join
  POST   /communities/{id}/channels
  GET    /communities/{id}/channels
  PATCH  /channels/{id}      (owner only)
  DELETE /channels/{id}      (owner only)
  GET    /channels/{id}/messages
  GET    /channels/{id}/messages/search
                             (?q=, limit=20)

  Owner-only routes answer 403 for
  non-owners, 404 for a nonexistent
  id — MutationResult keeps those
  two cases distinct end-to-end.

  Search (issue #118): plain
  case-insensitive substring test
  (position(lower(q) in lower(body))
  > 0), not full-text search — no
  ranking/stemming, a first-version
  simplification. Missing/empty
  'q' is 400. Newest match first.
end note

note right of WebSocketServer
  Protocol per connection:
  1st frame: {"token", "channel_id"}
  after that, key-presence dispatch
  (checked in this order):
    {"call_join": true}
      -> {"call_roster": [...]} to
         sender, {"call_peer_joined"}
         to other call participants
    {"call_leave": true}
      -> {"call_peer_left"} to the
         remaining call participants
         (same on Close/Error without
         an explicit leave)
    {"call_signal": {"to","payload"}}
      -> relayed verbatim as
         {"call_signal": {"from",
         "payload"}} to that one
         participant's socket, or
         {"error": "peer not in
         call"} to the sender
    {"typing": true}
      -> {"user_typing": "<login>"}
         to every other *chat*
         subscriber (issue #96,
         never echoed back to sender)
    {"edit_message": {"id","body"}}
      -> (issue #107) only the
         message's own author may
         edit it — {"error": ...}
         to the sender on 404/403,
         else {"message_edited":
         {"id","body","edited_at"}}
         broadcast to every *chat*
         subscriber
    {"delete_message": {"id"}}
      -> same authorship rule,
         {"message_deleted": {"id"}}
         broadcast on success
    {"body"} (fallback)
      -> broadcast to every *chat*
         subscriber of that channel

  Call participants (callParticipants_)
  are a separate, per-channel presence
  set from *chat* subscribers
  (subscriptions_) — being subscribed
  to a channel's text chat does not
  imply being in its call, and vice
  versa. This server only relays call
  signaling (SDP/ICE payloads) — it
  never inspects "payload" contents.
  See issue #46.
end note

@enduml
