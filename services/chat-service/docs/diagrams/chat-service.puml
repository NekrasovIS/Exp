@startuml chat-service
title chat-service — src/

package "cpp-httplib / ixwebsocket" {
  class "httplib::Server" as HttplibServer
  class "ix::WebSocketServer" as IxWebSocketServer
}

package "libpqxx" {
  class "pqxx::connection" as PqxxConnection
}

class Community {
  +id : int64
  +name : string
  +ownerLogin : string
}
class Channel {
  +id : int64
  +communityId : int64
  +name : string
  +ownerLogin : string
  +isEncrypted : bool
}
class Message {
  +id : int64
  +authorLogin : string
  +body : string
  +sentAt : string
  +attachmentId : optional<int64>
  +attachmentFilename : optional<string>
}
enum MutationResult {
  kSuccess
  kNotFound
  kForbidden
  kConflict
}
class AttachmentMetadata {
  +id : int64
  +filename : string
  +contentType : string
  +sizeBytes : int64
}
class AttachmentData {
  +filename : string
  +contentType : string
  +data : string
}

package "chat_service::base64" <<Rectangle>> {
  class Base64 << (N,orchid) namespace >> {
    +decode(text: string) : optional<string>
  }
}

class ChatRepository {
