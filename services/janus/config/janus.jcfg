# Оверрайд дефолтного конфига образа canyan/janus-gateway (issue #230).
# Janus монтирует этот файл поверх /usr/local/etc/janus/janus.jcfg
# целиком (не диффом/мёржем с дефолтным), поэтому здесь сознательно
# оставлены только два реально нужных для этого деплоя раздела —
# остальное (certificates, plugins, transports, loggers, events)
# работает на встроенных дефолтах Janus и не нуждается в переопределении.
# Полный дефолтный конфиг образа сохранён рядом как janus.jcfg.default
# для справки при последующих доработках (issue #231/#232).

general: {
	configs_folder = "/usr/local/etc/janus"
	plugins_folder = "/usr/local/lib/janus/plugins"
	transports_folder = "/usr/local/lib/janus/transports"
	events_folder = "/usr/local/lib/janus/events"
	loggers_folder = "/usr/local/lib/janus/loggers"
	debug_level = 4
	# Тот же admin_secret, что и в дефолтном конфиге образа — Admin API
	# наружу не публикуется (порт 7088/7188 не проброшен в
	# docker-compose.yml), сервис доступен только другим контейнерам
	# в той же docker-сети.
	admin_secret = "janusoverlord"
}

media: {
	# Должно совпадать с диапазоном UDP-портов, который образ
	# объявляет как EXPOSE и который проброшен в docker-compose.yml —
	# иначе Janus будет договариваться о RTP на портах, не
	# опубликованных наружу контейнера, и медиа не пройдёт через
	# Docker-сеть при подключении реального (не localhost) клиента.
	rtp_port_range = "10000-10200"
}

nat: {
	# STUN обязателен: Docker Desktop (Windows/macOS) прячет реальный
	# IP хоста за NAT собственной виртуальной сети, поэтому host-кандидаты
	# ICE сами по себе недостаточны для connectivity даже в рамках
	# локальной разработки — нужен srflx-кандидат от публичного STUN.
	stun_server = "stun.l.google.com"
	stun_port = 19302
	nice_debug = false
	ice_ignore_list = "vmnet"
}
