@startuml ui
title DeviceHub — src/ui

class MainWindow {
  -buildUi()
  -populateDevices()
  -onPlayToneClicked()
  -onToggleMicClicked()
  -onToggleCameraClicked()
  -onToggleScreenCaptureClicked()
  -onRequestTokenClicked()
  -onRegisterClicked()
  -onSendChatMessageClicked()
  -refreshCommunities()
  -refreshChannelsForSelectedCommunity()
  -openChannel(id: int64, name: QString)
  -closeChatView()
}

class CommunitiesPanel {
  +setCommunities(communities: QList<ChatItem>)
  +selectCommunityId(id: int64)
  +setCurrentUserLogin(login: QString)
  +listWidget() : QListWidget*
  +addButton() : QPushButton*
  +refreshButton() : QPushButton*
  -showAddDialog()
  -showContextMenu(pos: QPoint)
  .. signals ..
  +createRequested(name: QString)
  +renameRequested(id: int64, newName: QString)
  +deleteRequested(id: int64)
  +joinRequested(id: int64)
  +communitySelected(id: int64)
}

class ChannelsPanel {
  +setChannels(channels: QList<ChatItem>)
  +selectChannelId(id: int64)
  +setCurrentUserLogin(login: QString)
  +listWidget() : QListWidget*
  +addButton() : QPushButton*
  +refreshButton() : QPushButton*
  -showAddDialog()
  -showContextMenu(pos: QPoint)
  .. signals ..
  +createRequested(name: QString)
  +renameRequested(id: int64, newName: QString)
  +deleteRequested(id: int64)
  +channelSelected(id: int64, name: QString)
}

class ChatView {
  +showPlaceholder()
  +showChannel(channelName: QString)
  +appendLine(text: QString)
  +clearLog()
  +chatLog() : QPlainTextEdit*
  +messageEdit() : QLineEdit*
  +sendButton() : QPushButton*
}

class AccountMenu {
  +loginEdit() : QLineEdit*
  +passwordEdit() : QLineEdit*
  +requestTokenButton() : QPushButton*
  +registerButton() : QPushButton*
  +statusLabel() : QLabel*
  +toggleButton() : QPushButton*
  -togglePopup()
}

class SettingsDialog {
  +outputCombo() : QComboBox*
  +playToneButton() : QPushButton*
  +inputCombo() : QComboBox*
  +toggleMicButton() : QPushButton*
  +micLevelBar() : QProgressBar*
  +micStatusLabel() : QLabel*
  +cameraCombo() : QComboBox*
  +toggleCameraButton() : QPushButton*
  +videoPreview() : QVideoWidget*
  +cameraStatusLabel() : QLabel*
  +screenCombo() : QComboBox*
  +toggleScreenCaptureButton() : QPushButton*
  +screenPreview() : QVideoWidget*
  +screenStatusLabel() : QLabel*
}

class FooterBar {
  +setProfileText(text: QString)
  +settingsButton() : QPushButton*
}

package "src/devices" {
  class DeviceEnumerator
  class AudioOutputDevice
  class AudioInputDevice
  class CameraDevice
  class ScreenCaptureDevice
}

package "src/auth" {
  class AuthClient
}

package "src/chat" {
  class ChatClient
  class ChatRestClient
}

MainWindow *-- CommunitiesPanel : owns (top-left sidebar)
MainWindow *-- ChannelsPanel : owns (bottom-left sidebar)
MainWindow *-- ChatView : owns (main content area)
MainWindow *-- AccountMenu : owns (top-right)
MainWindow *-- SettingsDialog : owns (opened from FooterBar)
MainWindow *-- FooterBar : owns (bottom)

MainWindow *-- DeviceEnumerator : owns
MainWindow *-- AudioOutputDevice : owns
MainWindow *-- AudioInputDevice : owns
MainWindow *-- CameraDevice : owns
MainWindow *-- ScreenCaptureDevice : owns
MainWindow *-- AuthClient : owns
MainWindow *-- ChatClient : owns
MainWindow *-- ChatRestClient : owns

MainWindow ..> AuthClient : tokenReceived()\ntokenVerified() >
MainWindow ..> AuthClient : errorOccurred() >
MainWindow ..> ChatClient : subscribed()\nmessageReceived() >
MainWindow ..> ChatRestClient : communitiesListed()\nchannelsListed() >
MainWindow ..> ChatRestClient : communityCreated()/Renamed()/Deleted()\nchannelCreated()/Renamed()/Deleted() >

CommunitiesPanel ..> MainWindow : createRequested()/renameRequested()\ndeleteRequested()/joinRequested()\ncommunitySelected() >
ChannelsPanel ..> MainWindow : createRequested()/renameRequested()\ndeleteRequested()/channelSelected() >
MainWindow ..> ChatView : showChannel()/showPlaceholder()\nappendLine()/clearLog() >

MainWindow ..> AudioInputDevice : levelChanged() >
MainWindow ..> FooterBar : settingsButton().clicked() >
FooterBar ..> SettingsDialog : show()/raise() <

note right of MainWindow
  Только Qt Widgets + сигналы/слоты
  от devices/. Не обращается к
  low-level Qt Multimedia API напрямую.

  Панели (CommunitiesPanel/ChannelsPanel/
  ChatView/AccountMenu/SettingsDialog/
  FooterBar) — чистое представление:
  строят свои контролы и шлют
  request-сигналы. MainWindow остаётся
  единственным владельцем бизнес-логики
  и всех устройств/клиентов, как и раньше.

  Выбор сообщества в CommunitiesPanel
  подгружает его каналы в ChannelsPanel;
  выбор канала там открывает чат в
  ChatView и (пере)подключает ChatClient.
  Владелец сообщества/канала (из ответа
  chat-service) решает, показывать ли
  в контекстном меню Rename/Delete —
  сервер всё равно проверяет права
  повторно (403 для не-владельца).
end note

@enduml
